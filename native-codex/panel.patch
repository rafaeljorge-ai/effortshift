+            let (_, cursor_y) = renderable.cursor_pos(area).expect("editable prompt cursor");
+            assert!(rows[usize::from(cursor_y)].contains("last line"), "{text}");
+            if height > 6 {
+                assert!(text.contains("queued-marker"), "{text}");
+            }
+            if height == 24 {
+                assert!(
+                    text.contains("EffortShift") && text.contains("Codex quota"),
