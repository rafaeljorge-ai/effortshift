+            chat.bottom_pane.effortshift = panel;
+            let renderable = chat.bottom_pane.as_renderable_with_options(options);
+            let actual_height = renderable.desired_height(80);
+            assert!(actual_height >= native_height);
+            assert!(actual_height <= height.max(native_height));
+            let area = Rect::new(0, 0, 80, actual_height);
+            let mut buffer = Buffer::empty(area);
+            renderable.render(area, &mut buffer);
+            let rows: Vec<_> = buffer
+                .content
+                .chunks(80)
+                .map(|row| row.iter().map(|cell| cell.symbol()).collect::<String>())
+                .collect();
+            let text = rows.join("\n");
