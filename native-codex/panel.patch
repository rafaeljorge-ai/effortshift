+//! Session-only EffortShift controls. Auto uses local rules, never an extra model call.
+use super::ChatWidget;
+use codex_app_server_protocol::RateLimitSnapshot;
+use codex_protocol::config_types::ModeKind;
+use codex_protocol::openai_models::ReasoningEffort as Effort;
+use crossterm::event::KeyCode;
+use crossterm::event::KeyEvent;
+use crossterm::event::KeyEventKind;
+use crossterm::event::KeyModifiers;
+use ratatui::buffer::Buffer;
+use ratatui::layout::Rect;
+use ratatui::style::Color;
+use ratatui::style::Style;
+use ratatui::text::Line;
+use ratatui::text::Span;
+use ratatui::widgets::Block;
+use ratatui::widgets::BorderType;
+use ratatui::widgets::Paragraph;
+use ratatui::widgets::Wrap;
+use regex_lite::Regex;
+use std::sync::LazyLock;
+
+use crate::render::renderable::Renderable;
+
+const LEVELS: [Effort; 5] = [
+    Effort::Low,
+    Effort::Medium,
+    Effort::High,
+    Effort::XHigh,
+    Effort::Max,
+];
+// Usage snapshots expire conservatively; never infer a fresh balance after a reset.
+const QUOTA_FRESH_SECONDS: i64 = 300;
+static RULES: LazyLock<[Regex; 5]> = LazyLock::new(|| {
+    [
+    r"(?i)\b(auth|autentica|autoriza|rls|tenant|isolamento|permiss|seguran|security|finance|pagamento|migration|migraç|credencia)",
+    r"(?i)\b(arquitet|diagn[oó]stic|refator|investig|complex|architecture|debug)",
+    r"(?i)^(continue|continuar|prossiga|continue de onde)",
+    r"(?i)\b(implement|crie|criar|construa|corrija|corrigir|fix|build|develop)",
+    r"(?i)^(oi|ol[aá]|hello|obrigad[oa]|qual [ée]|o que [ée]|quanto [ée]|what is)(\s|$|[?.,!])",
+].map(|pattern| Regex::new(pattern).expect("valid EffortShift rule"))
+});
+
+fn decide(
+    prompt: &str,
+    save: bool,
+    supported: &[Effort],
+    previous: Option<&Effort>,
+    previous_critical: bool,
+) -> Result<(Option<Effort>, &'static str, bool), String> {
+    let supported: Vec<_> = LEVELS
+        .iter()
+        .filter(|e| supported.contains(e))
+        .cloned()
+        .collect();
+    let normalized = prompt.to_lowercase();
+    let prompt = normalized.as_str();
+    let continuation = RULES[2].is_match(prompt.trim());
+    let critical = RULES[0].is_match(prompt) || (continuation && previous_critical);
+    if critical && !supported.iter().any(|e| rank(e) >= 2) {
+        return Err(
+            "EffortShift: this model cannot meet the high risk floor; select another model.".into(),
+        );
+    }
+    if supported.is_empty() {
+        return Ok((None, "Catalog unavailable; effort unchanged", false));
+    }
+    let mut target = if save { 0 } else { 1 };
+    if RULES[1].is_match(prompt) {
+        target = 2;
+    }
+    if continuation && let Some(previous) = previous.filter(|e| supported.contains(e)) {
+        target = target.max(rank(previous));
+    }
+    if RULES[3].is_match(prompt) {
+        target = target.max(1);
+    }
+    if !save
+        && !critical
+        && !RULES[1].is_match(prompt)
+        && !RULES[3].is_match(prompt)
+        && prompt.encode_utf16().count() < 180
+        && RULES[4].is_match(prompt.trim())
+    {
+        target = 0;
+    }
+    // Save caps ordinary work; the risk floor always takes precedence.
+    if save {
+        target = target.min(1);
+    }
+    if critical {
+        target = target.max(2);
+    }
+    let effort = supported
+        .iter()
+        .find(|e| rank(e) >= target)
+        .or_else(|| supported.last())
+        .cloned();
+    Ok((
+        effort,
+        if critical {
+            "Risk floor: high (security/data/permissions)"
+        } else if save {
+            "Local rules · Save; no evaluator call"
+        } else {
+            "Local rules · balanced; no evaluator call"
+        },
+        critical,
+    ))
+}
+
+fn rank(effort: &Effort) -> usize {
+    LEVELS.iter().position(|e| e == effort).unwrap_or(0)
+}
+
+#[derive(Clone)]
+pub(crate) struct EffortShift {
+    auto: bool,
+    save_until: Option<i64>,
+    previous: [Option<Effort>; 2],
+    previous_critical: bool,
+    reason: Option<String>,
+    quota: Vec<QuotaWindow>,
+    captured_at: Option<i64>,
+}
+
+impl Default for EffortShift {
+    fn default() -> Self {
+        Self {
+            auto: true,
+            save_until: None,
+            previous: [None, None],
+            previous_critical: false,
+            reason: Some("Local rules ready for next turn".into()),
+            quota: Vec::new(),
+            captured_at: None,
+        }
+    }
+}
+
+#[derive(Clone)]
+struct QuotaWindow {
+    used: f64,
+    minutes: Option<i64>,
+    reset: Option<i64>,
+}
+
+impl QuotaWindow {
+    fn fresh(&self, captured_at: Option<i64>, now: i64) -> bool {
+        self.used.is_finite()
+            && self.used >= 0.0
+            && self.used <= 100.0
+            && captured_at.is_some_and(|at| now >= at && now - at < QUOTA_FRESH_SECONDS)
+            && self.reset.is_none_or(|reset| reset > now)
+    }
+}
+
+impl EffortShift {
+    pub(super) fn manual(&mut self) {
+        self.auto = false;
+        self.reason = Some("Native/manual selection".into());
+    }
+
+    pub(super) fn clear_quota(&mut self) {
+        self.quota.clear();
+        self.captured_at = None;
+        self.save_until = None;
+    }
+
+    pub(super) fn update_quota(&mut self, snapshot: &RateLimitSnapshot, now: i64) {
+        self.quota = snapshot
+            .primary
+            .iter()
+            .chain(snapshot.secondary.iter())
+            .map(|window| QuotaWindow {
+                used: f64::from(window.used_percent),
+                minutes: window.window_duration_mins,
+                reset: window.resets_at,
+            })
+            .collect();
+        self.captured_at = Some(now);
+    }
+
+    fn save(&self, now: i64) -> bool {
+        self.save_until.is_some_and(|until| until > now)
+    }
+
+    fn quota_line(&self, now: i64) -> Line<'static> {
+        let fresh: Vec<_> = self
+            .quota
+            .iter()
+            .filter(|w| w.fresh(self.captured_at, now))
+            .collect();
+        let hot = fresh.iter().any(|w| w.used >= 80.0);
+        let text = if fresh.is_empty() {
+            if self.quota.is_empty() {
+                "Codex quota: unavailable".into()
+            } else {
+                "Codex quota: stale/reset; awaiting refresh".into()
+            }
+        } else {
+            format!(
+                "{}Codex quota: {}",
+                if hot { "HOT · " } else { "" },
+                fresh
+                    .iter()
+                    .map(|w| {
+                        let window = w
+                            .minutes
+                            .map(|m| {
+                                if m % 1440 == 0 {
+                                    format!("{}d", m / 1440)
+                                } else if m % 60 == 0 {
+                                    format!("{}h", m / 60)
+                                } else {
+                                    format!("{m}m")
+                                }
+                            })
+                            .unwrap_or_else(|| "window ?".into());
+                        let reset = w
+                            .reset
+                            .and_then(|r| chrono::DateTime::from_timestamp(r, 0))
+                            .map(|r| {
+                                r.with_timezone(&chrono::Local)
+                                    .format("%a %H:%M")
+                                    .to_string()
+                            })
+                            .unwrap_or_else(|| "unknown".into());
+                        format!("{:.0}% / {window} · reset {reset}", w.used)
+                    })
+                    .collect::<Vec<_>>()
+                    .join(" | ")
+            )
+        };
+        Line::styled(
+            text,
+            if hot {
+                Style::default().fg(Color::Yellow).bold()
+            } else {
+                Style::default().fg(Color::DarkGray)
+            },
+        )
+    }
+}
+
+#[derive(Clone)]
+pub(crate) struct EffortPanel {
+    state: EffortShift,
+    supported: Vec<Effort>,
+    selected: Option<Effort>,
+    default_effort: Option<Effort>,
+    plan: bool,
+}
+
+impl EffortPanel {
+    fn hot(&self, now: i64) -> bool {
+        self.state
+            .quota
+            .iter()
+            .any(|w| w.fresh(self.state.captured_at, now) && w.used >= 80.0)
+    }
+
+    fn hot_paragraph(&self, now: i64) -> Paragraph<'static> {
+        let style = Style::default()
+            .fg(Color::Yellow)
+            .bg(Color::Rgb(44, 33, 12));
+        Paragraph::new(
+            self.state
+                .quota_line(now)
+                .to_string()
+                .trim_start_matches("HOT · ")
+                .to_string(),
+        )
+        .wrap(Wrap { trim: true })
+        .style(style)
+        .block(
+            Block::bordered()
+                .border_type(BorderType::Rounded)
+                .border_style(style)
+                .title(" Running hot ")
+                .title(
+                    Line::from(format!(
+                        " Save {} ",
+                        if self.state.save(now) { "on" } else { "off" }
+                    ))
+                    .right_aligned(),
+                ),
+        )
+    }
+
+    fn paragraph(&self, width: u16, now: i64) -> Paragraph<'static> {
+        let mut lines = Vec::new();
+        if !self.hot(now) {
+            lines.push(self.state.quota_line(now));
+        }
+        let effort = self
+            .selected
+            .as_ref()
+            .or(self.default_effort.as_ref())
+            .map(Effort::as_str)
+            .unwrap_or("unknown");
+        let mut status = Line::from(Span::styled(
+            format!(
+                "Next effort: {effort}{}{} · Auto {} · Save {}{}",
+                if self.selected.is_none() {
+                    " (default)"
+                } else {
+                    ""
+                },
+                if self.plan { " · Plan" } else { "" },
+                if self.state.auto { "on" } else { "off" },
+                if self.state.save(now) { "on" } else { "off" },
+                if self.supported.is_empty() {
+                    " · catalog unavailable"
+                } else {
+                    ""
+                },
+            ),
+            Style::default().fg(Color::Cyan),
+        ));
+        let reason = Line::from(Span::styled(
+            self.state
+                .reason
+                .as_deref()
+                .unwrap_or("Native/manual selection")
+                .to_string(),
+            Style::default().fg(Color::DarkGray),
+        ));
+        if status.width() + 2 + reason.width() <= usize::from(width) {
+            status.spans.push(Span::raw("  "));
+            status.spans.extend(reason.spans);
+            lines.push(status);
+        } else {
+            lines.push(status);
+            lines.push(reason);
+        }
+        lines.push(Line::styled(
+            "EffortShift · /effortshift auto · /effortshift save · /model",
+            Style::default().fg(Color::DarkGray),
+        ));
+        Paragraph::new(lines).wrap(Wrap { trim: true })
+    }
+}
+
+impl Renderable for EffortPanel {
+    fn render(&self, mut area: Rect, buf: &mut Buffer) {
+        let now = chrono::Utc::now().timestamp();
+        if area.height < self.desired_height(area.width) {
+            let summary = Paragraph::new(format!(
+                "{}Next {} · Auto {} · Save {}",
+                if self.hot(now) { "HOT " } else { "" },
+                self.selected
+                    .as_ref()
+                    .or(self.default_effort.as_ref())
+                    .map(Effort::as_str)
+                    .unwrap_or("unknown"),
+                if self.state.auto { "on" } else { "off" },
+                if self.state.save(now) { "on" } else { "off" },
+            ))
+            .style(Style::default().fg(if self.hot(now) {
+                Color::Yellow
+            } else {
+                Color::Cyan
+            }));
+            Renderable::render(&summary, area, buf);
+            return;
+        }
+        if self.hot(now) {
+            let hot = self.hot_paragraph(now);
+            let height = (hot.line_count(area.width.saturating_sub(2)) as u16).min(area.height);
+            Renderable::render(&hot, Rect { height, ..area }, buf);
+            area.y = area.y.saturating_add(height);
+            area.height = area.height.saturating_sub(height);
+        }
+        Renderable::render(&self.paragraph(area.width, now), area, buf);
+    }
+    fn desired_height(&self, width: u16) -> u16 {
+        let now = chrono::Utc::now().timestamp();
+        let hot_height = if self.hot(now) {
+            self.hot_paragraph(now).line_count(width.saturating_sub(2))
+        } else {
+            0
+        };
+        (hot_height + self.paragraph(width, now).line_count(width)) as u16
+    }
+}
+
+impl ChatWidget {
+    pub(super) fn refresh_effortshift(&mut self) {
+        let preset = self.current_model_preset();
+        let default_effort = preset
+            .as_ref()
+            .map(|preset| preset.default_reasoning_effort.clone());
+        self.bottom_pane.effortshift = Some(EffortPanel {
+            state: self.effortshift.clone(),
+            default_effort,
+            supported: preset
+                .map(|preset| {
+                    preset
+                        .supported_reasoning_efforts
+                        .into_iter()
+                        .map(|option| option.effort)
+                        .collect()
+                })
+                .unwrap_or_default(),
+            selected: self.effective_reasoning_effort(),
+            plan: self.active_mode_kind() == ModeKind::Plan,
+        });
+    }
+
+    pub(super) fn handle_effortshift_shortcut(&mut self, key: KeyEvent) -> bool {
+        if key.kind != KeyEventKind::Press
+            || key.modifiers != KeyModifiers::ALT
+            || !matches!(key.code, KeyCode::Char('a' | 's'))
+        {
+            return false;
+        }
+        self.handle_effortshift_command(if key.code == KeyCode::Char('a') {
+            "auto"
+        } else {
+            "save"
+        })
+    }
+
+    pub(super) fn handle_effortshift_command(&mut self, args: &str) -> bool {
+        if !self.bottom_pane.no_modal_or_popup_active() {
+            return false;
+        }
+        if self.blocks_direct_input {
+            self.add_error_message(super::PARENT_OWNED_INPUT_MESSAGE.to_string());
+            return true;
+        }
+        let now = chrono::Utc::now().timestamp();
+        let args = args.trim();
+        if args.is_empty() {
+            let effort = self.effective_reasoning_effort().or_else(|| {
+                self.current_model_preset()
+                    .map(|preset| preset.default_reasoning_effort)
+            });
+            self.add_info_message(format!(
+                "EffortShift · Next effort: {} · Auto {} · Save {}",
+                effort.as_ref().map(Effort::as_str).unwrap_or("unknown"),
+                if self.effortshift.auto { "on" } else { "off" },
+                if self.effortshift.save(now) { "on" } else { "off" },
+            ), Some("/effortshift auto: toggle Auto\n/effortshift save: toggle Save (fresh quota required)\n/model: select effort manually".into()));
+            return true;
+        }
+        if !matches!(args, "auto" | "save") {
+            self.add_error_message("Usage: /effortshift [auto|save]".into());
+            return true;
+        }
+        if args == "auto" {
+            self.effortshift.auto = !self.effortshift.auto;
+            self.effortshift.reason = Some(
+                if self.effortshift.auto {
+                    "Local rules ready for next turn"
+                } else {
+                    "Native/manual selection"
+                }
+                .into(),
+            );
+        } else if self.effortshift.save(now) {
+            self.effortshift.save_until = None;
+        } else {
+            self.effortshift.save_until = self
+                .effortshift
+                .quota
+                .iter()
+                .filter(|w| w.fresh(self.effortshift.captured_at, now))
+                .filter_map(|w| w.reset)
+                .min();
+            if self.effortshift.save_until.is_none() {
+                self.effortshift.reason =
+                    Some("Save unavailable: fresh quota/reset required".into());
+            }
+        }
+        self.refresh_effortshift();
+        self.request_redraw();
+        true
+    }
+
+    /// Runs only for a new turn, before effective_mode is captured. Steering bypasses it.
+    pub(super) fn resolve_effortshift(&mut self, prompt: &str) -> Result<(), String> {
+        if !self.effortshift.auto {
+            return Ok(());
+        }
+        let supported = self
+            .current_model_preset()
+            .map(|preset| {
+                preset
+                    .supported_reasoning_efforts
+                    .into_iter()
+                    .map(|option| option.effort)
+                    .collect::<Vec<_>>()
+            })
+            .unwrap_or_default();
+        let plan = self.active_mode_kind() == ModeKind::Plan;
+        let mode_index = usize::from(plan);
+        let decision = decide(
+            prompt,
+            self.effortshift.save(chrono::Utc::now().timestamp()),
+            &supported,
+            self.effortshift.previous[mode_index].as_ref(),
+            self.effortshift.previous_critical,
+        );
+        let (effort, reason, critical) = match decision {
+            Ok(decision) => decision,
+            Err(error) => {
+                self.effortshift.reason = Some("Blocked: high risk floor unavailable".into());
+                self.refresh_effortshift();
+                return Err(error);
+            }
+        };
+        if let Some(effort) = effort {
+            if plan {
+                self.set_plan_mode_reasoning_effort(Some(effort.clone()));
+            } else {
+                self.set_reasoning_effort(Some(effort.clone()));
+            }
+            self.effortshift.previous[mode_index] = Some(effort);
+            self.effortshift.auto = true;
+        }
+        self.effortshift.previous_critical = critical;
+        self.effortshift.reason = Some(reason.into());
+        self.refresh_effortshift();
+        Ok(())
+    }
+}
