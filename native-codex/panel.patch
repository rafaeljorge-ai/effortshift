+#[tokio::test]
+async fn effortshift_short_multiline_keeps_history_panel_and_composer_cursor() -> Result<()> {
+    for working in [false, true] {
+        for (draft, cursor_text) in [
+            ("draft\nsecond line\nthird line".to_string(), "third line"),
+            (
+                format!("{}last line", "draft line\n".repeat(30)),
+                "last line",
+            ),
+        ] {
+            let mut app = crate::app::test_support::make_test_app().await;
+            let thread_id = ThreadId::new();
+            attach_thread(&mut app, thread_id);
+            if working {
+                app.chat_widget.handle_server_notification(
+                    ServerNotification::TurnStarted(
+                        codex_app_server_protocol::TurnStartedNotification {
+                            thread_id: thread_id.to_string(),
+                            turn: codex_app_server_protocol::Turn {
+                                id: "layout-turn".into(),
+                                root_turn_id: None,
+                                items_view: codex_app_server_protocol::TurnItemsView::Full,
+                                items: Vec::new(),
+                                status: codex_app_server_protocol::TurnStatus::InProgress,
+                                error: None,
+                                started_at: None,
+                                completed_at: None,
+                                duration_ms: None,
+                            },
+                        },
+                    ),
+                    None,
+                );
+            }
+            app.transcript_cells = vec![Arc::new(crate::history_cell::PlainHistoryCell::new(
+                (1..=40)
+                    .map(|row| format!("Transcript row {row:02}").into())
+                    .collect(),
+            ))];
+            app.chat_widget.apply_external_edit(draft.clone());
+            let mut tui = crate::tui::test_support::make_test_tui()?;
+            tui.set_owned_screen(/*owned*/ true)?;
+            let size = Size::new(40, 12);
+            tui.terminal.resize(size)?;
+            let panel = crate::chatwidget::tests::helpers::replace_effortshift_panel(
+                &mut app.chat_widget,
+                None,
+            );
+            let native_bottom = app.render_owned_transcript(&mut tui, size)?;
+            let native_cursor = tui.terminal.last_known_cursor_pos;
+            let native = buffer_text(crate::custom_terminal::test_support::last_rendered_buffer(
+                &tui.terminal,
+            ));
+            let native_history = native
+                .lines()
+                .take(usize::from(native_bottom.y))
+                .any(|row| row.contains("Transcript row"));
+            if draft.lines().count() == 3 || !working {
+                assert!(native_history, "native history: {native}");
+            }
+            crate::chatwidget::tests::helpers::replace_effortshift_panel(
+                &mut app.chat_widget,
+                panel,
+            );
+            let bottom = app.render_owned_transcript(&mut tui, size)?;
+            let rendered = buffer_text(crate::custom_terminal::test_support::last_rendered_buffer(
