+// The native activity and editable prompt take priority over the optional panel.
+// Measurement, painting, and cursor placement share this allocation.
+struct EffortPanelLayout<'a> {
+    above: RenderableItem<'a>,
+    panel: &'a dyn Renderable,
+    composer: RenderableItem<'a>,
+    panel_budget: u16,
+}
+
+impl EffortPanelLayout<'_> {
+    fn panel_height(&self, width: u16) -> u16 {
+        let native_height = self
+            .above
+            .desired_height(width)
+            .saturating_add(self.composer.desired_height(width));
+        let remaining = self.panel_budget.saturating_sub(native_height);
+        let desired = self.panel.desired_height(width);
+        if desired <= remaining {
+            desired
+        } else {
+            remaining.min(1)
+        }
+    }
+
+    fn areas(&self, area: Rect) -> [Rect; 3] {
+        let above_desired = self.above.desired_height(area.width);
+        let composer_desired = self.composer.desired_height(area.width);
+        let panel_desired = self.panel_height(area.width);
+        let panel = if above_desired
+            .saturating_add(composer_desired)
+            .saturating_add(panel_desired)
+            <= area.height
+        {
+            panel_desired
+        } else {
+            0
+        };
+        // Match native Flex allocation: the composer is fixed, activity receives the remainder.
+        let composer = composer_desired.min(area.height.saturating_sub(panel));
+        let above = above_desired.min(area.height.saturating_sub(panel).saturating_sub(composer));
+        [
+            Rect::new(area.x, area.y, area.width, above),
+            Rect::new(area.x, area.y.saturating_add(above), area.width, panel),
+            Rect::new(
+                area.x,
+                area.y.saturating_add(above).saturating_add(panel),
+                area.width,
+                composer,
+            ),
+        ]
+    }
+}
+
+impl Renderable for EffortPanelLayout<'_> {
+    fn desired_height(&self, width: u16) -> u16 {
+        self.above
+            .desired_height(width)
+            .saturating_add(self.composer.desired_height(width))
+            .saturating_add(self.panel_height(width))
+    }
+
+    fn render(&self, area: Rect, buf: &mut Buffer) {
+        let [above, panel, composer] = self.areas(area);
+        self.above.render(above, buf);
+        if panel.height > 0 {
+            self.panel.render(panel, buf);
+        }
+        self.composer.render(composer, buf);
+    }
+
+    fn cursor_pos(&self, area: Rect) -> Option<(u16, u16)> {
+        self.composer.cursor_pos(self.areas(area)[2])
+    }
+
+    fn cursor_style(&self, area: Rect) -> crossterm::cursor::SetCursorStyle {
+        self.composer.cursor_style(self.areas(area)[2])
     }
 }
 
